generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Les 5 seules blockchains supportées par le bot.
enum Chain {
  ethereum
  base
  solana
  bnb
  arbitrum
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  createdAt DateTime @default(now())
  wallets   Wallet[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain     Chain
  address   String
  label     String
  createdAt DateTime @default(now())

  /// Watermarks de synchronisation du cache de transactions.
  lastSyncedAt    DateTime?
  /// EVM : dernier bloc indexé (les fetchs suivants repartent de ce bloc).
  lastSyncedBlock BigInt?
  /// Solana : signature la plus récente indexée (borne `until` du RPC).
  lastSignature   String?

  // Un même utilisateur ne peut pas enregistrer deux fois la même adresse
  // sur la même blockchain.
  @@unique([userId, chain, address])
  @@index([userId])
}

model TransactionCache {
  id              String   @id @default(cuid())
  chain           Chain
  walletAddress   String
  transactionHash String
  /// Un hash peut contenir plusieurs transferts (natif + tokens) :
  /// transferIndex les discrimine de façon déterministe.
  transferIndex   Int      @default(0)
  timestamp       DateTime
  blockNumber     BigInt?
  fromAddress     String
  toAddress       String?
  direction       String
  tokenAddress    String?
  tokenSymbol     String?
  tokenDecimals   Int?
  /// Montant en unités humaines (déjà normalisé par 10^decimals), en chaîne
  /// décimale pour éviter toute perte de précision.
  amount          String
  amountUsd       Float?
  fee             String?
  transactionType String?
  explorerUrl     String
  indexedAt       DateTime @default(now())

  @@unique([chain, walletAddress, transactionHash, transferIndex])
  @@index([walletAddress, chain, timestamp])
  @@index([chain])
  @@index([timestamp])
  @@index([transactionHash])
  @@index([tokenSymbol])
  @@index([amountUsd])
}
