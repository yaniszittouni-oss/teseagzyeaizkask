{
  "name": "chainscout-bot",
  "version": "1.0.0",
  "description": "Bot Discord read-only : enregistrement d'adresses blockchain (Ethereum, Base, Solana, BNB Smart Chain, Arbitrum) et recherche multi-filtres de leurs transactions.",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "register-commands": "tsx src/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@solana/web3.js": "^1.98.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "viem": "^2.23.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
